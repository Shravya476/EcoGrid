# EcoGrid email OTP - Brevo SMTP
# In Brevo: Settings -> SMTP & API -> SMTP, copy the SMTP login and generate an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_EMAIL=your-verified-sender-email
SMTP_SENDER_NAME=EcoGrid
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional: set a long random secret for deployment.
SECRET_KEY=replace-with-a-long-random-secret
